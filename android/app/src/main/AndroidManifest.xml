<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Barkod tarama için kamera izni -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Bildirimler (Android 13+ izin ister) ve arka plan kontrolü -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Uygulama içi güncelleme: indirilen yeni sürümü kurabilmek için -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Sahada kullanım / montaj anındaki konum (yalnızca o an, bir kez) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Güncelleme linkini tarayıcıda açabilmek için (Android 11+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="DEPO OTOMASYON SİSTEMİ"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- İndirilen APK'yı telefonun yükleyicisine verir (MainActivity.kt) -->
        <provider
            android:name=".ApkSaglayici"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Güncelleme kurulum sonucunu alır (MainActivity.kt) -->
        <receiver
            android:name=".KurulumAlici"
            android:exported="false" />
        <!-- Güncelleme indirmesi uygulama kapalıyken biterse bildirim -->
        <receiver
            android:name=".IndirmeAlici"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <!-- Güncelleme kurulduktan sonra "Güncellendi" bildirimi -->
        <receiver
            android:name=".GuncellendiAlici"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
